{
  --brand-text: "Protected content - visit www.aipages.dev";
  --brand-bg: #0f1117;
}


body::before {
  content: "" !important;
  position: fixed !important;
  inset: 0 !important;
  background-color: var(--brand-bg) !important;
  background-image: url("https://ai.aipages.dev/404.svg") !important;
  background-repeat: no-repeat !important;
  background-position: center center !important;
  background-size: min(60vw, 520px) auto !important;
  z-index: 2147483646 !important;
  pointer-events: none !important;
}


body::after {
  content: var(--brand-text) !important;
  position: fixed !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 8vh !important;
  text-align: center !important;
  color: #e8edf7 !important;
  font: 600 16px/1.5 -apple-system, "Segoe UI", Helvetica, Arial, sans-serif !important;
  letter-spacing: 0.3px !important;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9) !important;
  z-index: 2147483647 !important;
  pointer-events: none !important;
}


html,
body {
  background-color: var(--brand-bg) !important;
  background-image: url("https://ai.aipages.dev/404.svg") !important;
  background-repeat: no-repeat !important;
  background-position: center center !important;
  background-size: min(60vw, 520px) auto !important;
  background-attachment: fixed !important;
}